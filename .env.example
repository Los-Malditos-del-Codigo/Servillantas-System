# ==============================================================================
# CONFIGURACIÓN GENERAL Y ENDURECIMIENTO (SOC 2, ISO 27001, OWASP)
# ==============================================================================

# Entorno de ejecución (development / staging / production)
ENVIRONMENT=production

# Base de datos PostgreSQL (Servidor / Supabase / Contenedor)
DB_URL=jdbc:postgresql://localhost:5432/servillantas_db
DB_USER=postgres
DB_PASSWORD=CambiarPorPasswordRobusta!2026
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=2

# Seguridad Criptográfica - Llave secreta HMAC-SHA256 (Mínimo 256 bits / 32 bytes)
# ISO 27001 A.8.24 / OWASP API2
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LXNob3VsZC1iZS12ZXJ5LWxvbmctYW5kLXNlY3VyZS0yNTYtYml0cw==
JWT_EXPIRATION=3600000

# CORS - Orígenes permitidos (Nunca usar '*' con credenciales habilitadas)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# Eureka & Config Server
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# Puertos locales de microservicios
API_GATEWAY_PORT=8080
AUTH_PORT=8081
PRODUCTOS_PORT=8082
INVENTARIO_PORT=8083
COMPRAS_PORT=8084
VENTAS_PORT=8085
SERVICIOS_PORT=8086
ALERTAS_PORT=8087
REPORTES_PORT=8088
ASISTENTE_PORT=8089

