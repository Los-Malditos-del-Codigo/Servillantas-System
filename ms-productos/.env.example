# URL de conexión JDBC (Ejemplo con Supabase Pooler)
# Formato esperado: jdbc:postgresql://[host]:[puerto]/[base_de_datos]
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres

# Usuario de la base de datos (En Supabase suele tener el formato postgres.[id_proyecto])
DB_USER=postgres.tu_id_de_proyecto

# Contraseña del usuario de la base de datos
DB_PASSWORD=tu_contraseña_segura_aqui

# Orígenes permitidos para CORS (separados por coma si hay varios)
CORS_ALLOWED_ORIGINS=http://localhost:4200